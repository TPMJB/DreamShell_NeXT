      </panel>
      <panel name="advanced-page" width="640" height="480">
        <label x="24" y="20" width="592" height="28" font="title" color="#E7EEF4" text="ADVANCED FEATURES" align="left" valign="center" />
        <label x="24" y="56" width="592" height="20" font="small" color="#9BAFC1" text="Sector EDC + track CRC always run. No extra SD pass." align="left" valign="center" />
        <input type="button" x="36" y="84" width="568" height="36" name="recover-btn" onclick="export:gd_ripper_Toggle()" normal="b568-36-normal" highlight="b568-36-highlight" pressed="b568-36-pressed" disabled="b568-36-disabled">
          <label font="body" color="#F0F6FA" text="Recover damaged disc: OFF" align="center" />
        </input>
        <input type="button" x="36" y="128" width="568" height="36" name="edc-btn" onclick="export:gd_ripper_Toggle()" normal="b568-36-normal" highlight="b568-36-highlight" pressed="b568-36-pressed" disabled="b568-36-disabled">
          <label font="body" color="#F0F6FA" text="Advanced CRC (ECC + repair): OFF" align="center" />
        </input>
