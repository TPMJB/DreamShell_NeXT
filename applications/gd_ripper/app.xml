        </input>
        <label x="36" y="346" width="568" height="20" font="small" color="#9BAFC1" text="Recovery: defer bad sectors, then ask. BIN + ECC required." align="left" valign="center" />
        <label x="36" y="369" width="275" height="20" font="body" color="#9BAFC1" text="Total: --" align="left" valign="center" name="sectors-total-label" />
