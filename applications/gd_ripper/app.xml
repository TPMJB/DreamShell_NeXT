        </input>
        <input type="button" x="308" y="349" width="260" height="44" name="recovery-later" onclick="export:gd_ripper_ShowMainPage()" normal="b260-44-normal" highlight="b260-44-highlight" pressed="b260-44-pressed" disabled="b260-44-disabled">
