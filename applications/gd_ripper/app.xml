          <label font="body" color="#F0F6FA" text="Scan saved dump: read-back + sector checks (slow)" align="center" />
        </input>
        <input type="button" x="36" y="216" width="568" height="36" name="bad_btn" onclick="export:gd_ripper_Toggle()" normal="b568-36-normal" highlight="b568-36-highlight" pressed="b568-36-pressed" disabled="b568-36-disabled">
          <label font="body" color="#F0F6FA" text="Zero-fill unreadable sectors: OFF" align="center" />
        </input>
        <input type="button" x="36" y="260" width="568" height="36" name="use_bin_btn" onclick="export:gd_ripper_Toggle()" normal="b568-36-normal" highlight="b568-36-highlight" pressed="b568-36-pressed" disabled="b568-36-disabled">
          <label font="body" color="#F0F6FA" text="Track format: BIN (raw, recommended)" align="center" />
        </input>
        <input type="button" x="36" y="304" width="568" height="36" name="num-read" onclick="export:gd_ripper_Number_read()" normal="b568-36-normal" highlight="b568-36-highlight" pressed="b568-36-pressed" disabled="b568-36-disabled">
