        <label x="24" y="206" width="592" height="20" font="body" color="#D0DEE9" text="This dump stays incomplete until every hole is recovered." align="left" valign="center" />
        <label x="24" y="250" width="592" height="20" font="body" color="#D0DEE9" text="" name="recovery-limit" align="left" valign="center" />
        <label x="24" y="278" width="592" height="20" font="body" color="#9BAFC1" text="Recovery may take a while. Stop saves progress." align="left" valign="center" />
        <input type="button" x="24" y="349" width="260" height="44" name="recovery-start" onclick="export:gd_ripper_Recover()" normal="b260-44-normal" highlight="b260-44-highlight" pressed="b260-44-pressed" disabled="b260-44-disabled">
