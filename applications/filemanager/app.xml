      </input>
      <input name="delete-btn" type="button" x="300" y="0" width="92" height="28" onclick="FileManager:toolbarDelete()" normal="b92x28-normal" highlight="b92x28-highlight" pressed="b92x28-pressed" disabled="b92x28-disabled">
