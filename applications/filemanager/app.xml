      </input>
    </panel>
    <label name="controls" text="D-pad Browse / Switch pane   A Open   B Up   X Copy   Y Actions" x="24" y="446" width="592" height="22" font="tiny" color="#A7B9CB" align="left" valign="center" />
    <dialog name="modal-dialog" font="body" x="70" y="130" width="500" height="240" onconfirm="FileManager:ModalClick(true)" oncancel="FileManager:ModalClick(false)" />
