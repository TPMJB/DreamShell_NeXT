      <input name="copy-btn" type="button" x="0" y="0" width="92" height="28" onclick="FileManager:toolbarCopy()" normal="b92x28-normal" highlight="b92x28-highlight" pressed="b92x28-pressed" disabled="b92x28-disabled">
