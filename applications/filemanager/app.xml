      </input>
      <input name="rename-btn" type="button" x="100" y="0" width="92" height="28" onclick="FileManager:toolbarRename()" normal="b92x28-normal" highlight="b92x28-highlight" pressed="b92x28-pressed" disabled="b92x28-disabled">
        <label name="rename-btn-caption" text="Rename" x="12" y="0" width="68" height="28" font="small" color="#EFF5FC" align="left" valign="center" />
      </input>
      <input name="mkdir-btn" type="button" x="200" y="0" width="92" height="28" onclick="FileManager:toolbarMkdir()" normal="b92x28-normal" highlight="b92x28-highlight" pressed="b92x28-pressed" disabled="b92x28-disabled">
