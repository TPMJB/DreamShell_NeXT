      </input>
      <input name="archive-btn" type="button" x="400" y="0" width="92" height="28" onclick="FileManager:toolbarArchive()" normal="b92x28-normal" highlight="b92x28-highlight" pressed="b92x28-pressed" disabled="b92x28-disabled">
        <label name="archive-btn-caption" text="Archive" x="12" y="0" width="68" height="28" font="small" color="#EFF5FC" align="left" valign="center" />
      </input>
      <input name="mount-btn" type="button" x="500" y="0" width="92" height="28" onclick="FileManager:toolbarMountISO()" normal="b92x28-normal" highlight="b92x28-highlight" pressed="b92x28-pressed" disabled="b92x28-disabled">
